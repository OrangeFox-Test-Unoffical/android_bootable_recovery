cc_binary {
    name: "orscmd",
    stem: "twrp",
    recovery: true,

    // 用 FOX_* 版本宏(TW_VERSION_STR 链),显式声明使用 fox_recovery_defaults
    defaults: [
        "fox_recovery_defaults",
    ],

    srcs: [
        "orscmd.cpp",
    ],

    cflags: [
        "-W",
    ],

    pack_relocations: false,
}
